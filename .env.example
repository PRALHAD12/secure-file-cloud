# Copy this file to ".env" and fill in your own values. NEVER commit ".env".
# AWS credentials are NOT stored here. Run "aws configure" once (AWS CLI) and boto3
# will find them automatically. They are only used by the Python backend.

# "s3"    = real AWS S3 (use this for your demo)
# "local" = stores segments in backend/data/local_storage (for offline development/tests only)
STORAGE_BACKEND=s3

AWS_REGION=ap-south-1
S3_DATA_BUCKET=your-unique-data-bucket-name     # private bucket for encrypted segments
S3_SITE_BUCKET=your-unique-site-bucket-name     # private bucket for website files (used by deploy script)
CLOUDFRONT_DISTRIBUTION_ID=                     # e.g. E1ABCDEF234567 (used for cache invalidation)
CLOUDFRONT_DOMAIN=                              # e.g. d1234abcd.cloudfront.net (shown on dashboard)

# Presigned URLs live this many seconds (short-lived on purpose)
PRESIGN_EXPIRY_SECONDS=600
SEGMENT_SIZE_MB=5
MAX_FILE_MB=500

# Browser origins allowed to call the API (comma separated). Add your CloudFront URL here.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000

# Used only to sign local-mode URLs. Any long random string.
LOCAL_SIGNING_SECRET=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=5000
